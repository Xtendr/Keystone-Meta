# Optional. Leave empty; the public Raider.IO API does not require a key.
# If you do set one, it must be a Raider.IO API key, never the API URL.
# Do not put a real key in this file. User-level environment variable:
#   [System.Environment]::SetEnvironmentVariable("RAIDER_IO_API_KEY", "<key>", "User")
# The generator reads os.environ only. It does not load .env files.

RAIDER_IO_API_KEY=
# CURSEFORGE_TOKEN is a GitHub Actions secret only. Use your CurseForge
# account API token, not the numeric project ID.
